# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
# No secret may ever be exposed with a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/banana_fiber?schema=public"

# Cloudinary — upload UI arrives in Sprint 10. Server-side only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Safe to expose: the cloud name is part of every public image URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Admin session signing secret (Sprint 8). Minimum 32 characters.
SESSION_SECRET=""

# Public site URL, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
