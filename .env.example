# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
# No secret may ever be exposed with a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#
# The value below is for LOCAL DEVELOPMENT ONLY. In production (Vercel) it must
# be the hosted Supabase connection string — 127.0.0.1 there points at the
# build container itself, which runs no database, and the build fails while
# prerendering the homepage with "Can't reach database server".
#
# The build needs this to be reachable, not just present: pages are prerendered
# during `next build`, and the homepage reads products from the database.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/banana_fiber?schema=public"

# Cloudinary — upload UI arrives in Sprint 10. Server-side only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Safe to expose: the cloud name is part of every public image URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Admin session signing secret (Sprint 8). Minimum 32 characters.
SESSION_SECRET=""

# Public site URL, used for canonical URLs, sitemap and Open Graph tags.
#
# Must be a full origin including the scheme. A bare hostname
# ("example.vercel.app") is accepted and read as https, but anything that is
# not a URL at all stops the build with a message naming this variable.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
